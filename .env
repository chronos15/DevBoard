# Supabase > Project Settings / Connect
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_TOKEN

# URL pública da aplicação, usada nos redirects de Auth.
# Desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# WebRTC usa STUN público como fallback. Para chamadas confiáveis entre redes
# móveis/CGNAT/firewalls, configure TURN pela Edge Function webrtc-ice-servers.
# Nenhum segredo TURN deve ser colocado em NEXT_PUBLIC_*.
# Ative somente depois de configurar o provider Google no Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
