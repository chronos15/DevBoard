<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.com.softworksistema.taskboard.sharebridge"
    android:versionCode="224"
    android:versionName="1.0.0-v224" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_taskboard"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" >

        <!--
          Sem LAUNCHER de propósito: este APK é somente a ponte de compartilhamento.
          Ele aparece em Compartilhar, recebe a URI real do Android e abre o TaskBoard web.
        -->
        <activity
            android:name="br.com.softworksistema.taskboard.sharebridge.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="TaskBoard (Compartilhar)"
            android:noHistory="true" >
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>