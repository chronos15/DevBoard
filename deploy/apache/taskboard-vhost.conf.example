# XAMPP / Apache reverse proxy for TaskBoard
#
# Required modules in C:\xampp\apache\conf\httpd.conf:
#   LoadModule proxy_module modules/mod_proxy.so
#   LoadModule proxy_http_module modules/mod_proxy_http.so
#   LoadModule headers_module modules/mod_headers.so
#   LoadModule rewrite_module modules/mod_rewrite.so
#   LoadModule ssl_module modules/mod_ssl.so
#
# Also make sure:
#   Include conf/extra/httpd-vhosts.conf
#
# Replace taskboard.example.com and certificate paths.

<VirtualHost *:80>
    ServerName taskboard.example.com

    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName taskboard.example.com

    SSLEngine on
    SSLCertificateFile "C:/xampp/apache/conf/ssl/taskboard/fullchain.pem"
    SSLCertificateKeyFile "C:/xampp/apache/conf/ssl/taskboard/privkey.pem"

    ProxyPreserveHost On

    # The public request is HTTPS even though Apache talks to Next.js over localhost HTTP.
    RequestHeader set X-Forwarded-Proto "https"

    ProxyPass        / http://127.0.0.1:3000/ retry=0 timeout=120
    ProxyPassReverse / http://127.0.0.1:3000/

    ErrorLog  "logs/taskboard-error.log"
    CustomLog "logs/taskboard-access.log" combined
</VirtualHost>
