# TaskBoard - Windows physical server
# Save the real file as:
# C:\TaskBoard\config\.env.production.local
#
# Never commit the real file.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_TOKEN
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_SECRET

# Must be the real HTTPS URL served by Apache/XAMPP.
NEXT_PUBLIC_APP_URL=https://taskboard.example.com

NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional build metadata.
TASKBOARD_VERSION=V169
TASKBOARD_BUILD_TIMEZONE=America/Sao_Paulo
